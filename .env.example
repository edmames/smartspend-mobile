# SmartSpend environment variables (semua opsional)
#
# Aplikasi ini offline-first: tanpa file ini semuanya tetap berjalan.
# Salin ke `.env` dan isi hanya yang Anda butuhkan — Expo menanamkan variabel
# EXPO_PUBLIC_* ke dalam bundle, jadi JANGAN pernah menaruh kunci rahasia di sini
# (anon key Supabase memang publik; service-role key TIDAK boleh dipakai di klien).
#
# Di Vercel: Settings → Environment Variables. Di CI: GitHub → Settings →
# Secrets and variables → Actions. Panduan: docs/SUPABASE-SETUP.md

# --- Supabase (opsional; statusnya tampil di Setelan → Cloud) -----------------
# Settings → API di dashboard Supabase. Pakai URL project (bukan .../rest/v1).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Login dengan Google (opsional; lihat docs/GOOGLE-LOGIN-SETUP.md) ---------
# Hanya OAuth Client ID tipe *Web* yang dipakai di aplikasi.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Notifikasi Telegram (opsional; Setelan → Telegram) -----------------------
# Buat bot lewat @BotFather, ambil chat id dari @userinfobot.
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=

# --- Metadata aplikasi (opsional) --------------------------------------------
EXPO_PUBLIC_APP_ENV=development
