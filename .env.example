# SmartSpend environment variables (all optional)
#
# The app is offline-first: nothing here is required to run it. Copy this file
# to `.env` and fill in only what you need — Expo exposes EXPO_PUBLIC_* to the
# app bundle.

# --- Supabase (optional cloud sync; see README → "Optional: Supabase") ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Telegram notifications (optional; Settings → Telegram) ---
# Create a bot with @BotFather, then read the chat id from @userinfobot.
EXPO_PUBLIC_TELEGRAM_BOT_TOKEN=

# --- App metadata (optional) ---
EXPO_PUBLIC_APP_ENV=development
